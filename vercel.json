{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.py": {
      "maxDuration": 300,
      "excludeFiles": "{.cache,exports,.venv}/**"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/styles.css", "destination": "/web/styles.css" },
    { "source": "/cloud.css", "destination": "/web/cloud.css" },
    { "source": "/app.js", "destination": "/web/app.js" }
  ]
}
